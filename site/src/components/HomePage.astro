---
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";
import type { HomePageContent, Locale } from "../data/home";

interface Props {
  content: HomePageContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const githubIconPath =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z";
const themeIconPaths = {
  system: [
    "M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9",
    "M2 16h20",
    "M8 21h8",
    "M12 16v5",
  ],
  light: [
    "M12 3v1",
    "M12 20v1",
    "M3 12h1",
    "M20 12h1",
    "M18.364 5.636l-.707.707",
    "M6.343 17.657l-.707.707",
    "M5.636 5.636l.707.707",
    "M17.657 17.657l.707.707",
    "M8 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0",
  ],
  dark: [
    "M20.985 12.486A9 9 0 1 1 11.514 3.015 7 7 0 0 0 20.985 12.486",
  ],
};

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localePaths = {
  en: basePath,
  zh: `${basePath}zh/`,
};
const currentPath = localePaths[locale];
const faviconHref = `${basePath}favicon.svg`;
const demoLang = locale === "zh" ? "zh" : "en";
const demoSrc = `${basePath}demos/deeppapernote-readme-demo/index.html?lang=${demoLang}&theme=dark`;
const starLocale = locale === "zh" ? "zh-CN" : "en";
---

<html lang={content.lang} data-theme-preference="system" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={content.description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{content.title}</title>
    <script is:inline>
      (() => {
        const storageKey = "deeppapernote:theme";
        const allowedThemes = new Set(["system", "light", "dark"]);
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPreference = () => {
          try {
            const storedTheme = localStorage.getItem(storageKey);
            return allowedThemes.has(storedTheme) ? storedTheme : "system";
          } catch {
            return "system";
          }
        };

        const resolveTheme = (preference) =>
          preference === "system" ? (media.matches ? "dark" : "light") : preference;

        const syncButtons = (preference) => {
          document.querySelectorAll("[data-theme-choice]").forEach((button) => {
            const isActive = button.getAttribute("data-theme-choice") === preference;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));
          });
        };

        const syncDemos = (theme) => {
          document.querySelectorAll("[data-demo-frame]").forEach((frame) => {
            const src = frame.getAttribute("src");

            if (!src) {
              return;
            }

            const url = new URL(src, window.location.href);

            if (url.searchParams.get("theme") === theme) {
              return;
            }

            url.searchParams.set("theme", theme);
            frame.setAttribute("src", url.toString());
          });
        };

        const applyTheme = (preference) => {
          const normalizedPreference = allowedThemes.has(preference) ? preference : "system";
          const theme = resolveTheme(normalizedPreference);
          document.documentElement.dataset.themePreference = normalizedPreference;
          document.documentElement.dataset.theme = theme;
          syncButtons(normalizedPreference);
          syncDemos(theme);
        };

        const initialPreference = readPreference();
        document.documentElement.dataset.themePreference = initialPreference;
        document.documentElement.dataset.theme = resolveTheme(initialPreference);

        const bindControls = () => {
          applyTheme(readPreference());
          document.querySelectorAll("[data-theme-choice]").forEach((button) => {
            button.addEventListener("click", () => {
              const preference = button.getAttribute("data-theme-choice") || "system";

              try {
                localStorage.setItem(storageKey, preference);
              } catch {
                // Strict storage settings can reject localStorage writes.
              }

              applyTheme(preference);
            });
          });
        };

        const handleSystemChange = () => {
          if (readPreference() === "system") {
            applyTheme("system");
          }
        };

        if (media.addEventListener) {
          media.addEventListener("change", handleSystemChange);
        } else {
          media.addListener(handleSystemChange);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", bindControls, { once: true });
        } else {
          bindControls();
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header" aria-label={content.navLabel}>
      <a class="brand" href={currentPath} aria-label={content.brandHomeLabel}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" focusable="false">
            <path
              d="M19 14h13c12 0 20 7.5 20 18s-8 18-20 18H19V14Zm10 9v18h4c6.2 0 10-3.4 10-9s-3.8-9-10-9h-4Z"
              fill="#faf9f5"
            />
            <path d="M32 23h1c6.2 0 10 3.4 10 9s-3.8 9-10 9h-1V23Z" fill="#cc785c" />
          </svg>
        </span>
        <span>DeepPaperNote</span>
      </a>
      <nav class="nav-links" aria-label={content.navLabel}>
        <a href="#showcase">{content.nav.showcase}</a>
        <a href="#pipeline">{content.nav.pipeline}</a>
        <a href="#install">{content.nav.install}</a>
      </nav>
      <div class="header-actions" aria-label={content.headerActionsLabel}>
        <div class="locale-switch" aria-label={content.languageSwitchLabel}>
          <a
            class:list={["locale-link", { "is-active": locale === "en" }]}
            href={localePaths.en}
            aria-current={locale === "en" ? "page" : undefined}
            aria-label={content.languageNames.en}
          >
            EN
          </a>
          <a
            class:list={["locale-link", { "is-active": locale === "zh" }]}
            href={localePaths.zh}
            aria-current={locale === "zh" ? "page" : undefined}
            aria-label={content.languageNames.zh}
          >
            ZH
          </a>
        </div>
        <div class="theme-switch" aria-label={content.themeSwitchLabel}>
          <button
            class="theme-button"
            type="button"
            data-theme-choice="system"
            aria-label={content.theme.systemLabel}
            aria-pressed="true"
          >
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {themeIconPaths.system.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </button>
          <button
            class="theme-button"
            type="button"
            data-theme-choice="light"
            aria-label={content.theme.lightLabel}
            aria-pressed="false"
          >
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {themeIconPaths.light.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </button>
          <button
            class="theme-button"
            type="button"
            data-theme-choice="dark"
            aria-label={content.theme.darkLabel}
            aria-pressed="false"
          >
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {themeIconPaths.dark.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </button>
        </div>
        <a
          class="star-pill"
          data-star-pill
          data-star-aria-template={content.starsAriaTemplate}
          href="https://github.com/917Dhj/DeepPaperNote"
          aria-label={content.githubStarsLabel}
        >
          <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d={githubIconPath} fill="currentColor" />
          </svg>
          <span class="github-label">GitHub</span>
          <span class="star-pill-divider" aria-hidden="true"></span>
          <span class="star-pill-icon" aria-hidden="true">★</span>
          <span
            class="star-pill-count"
            data-star-count
            data-star-fallback={content.starsFallback}
            data-star-locale={starLocale}
          >
            {content.starsFallback}
          </span>
        </a>
        <a class="button button-primary" href="#install">{content.installLabel}</a>
      </div>
    </header>

    <main>
      <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-content">
          <h1 id="hero-title">{content.hero.title}</h1>
          <p>{content.hero.body}</p>
          <div class="hero-actions" aria-label={content.hero.actionsLabel}>
            <a class="button button-primary" href="#install">{content.hero.install}</a>
            <a class="button button-on-dark github-link" href="https://github.com/917Dhj/DeepPaperNote">
              <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d={githubIconPath} fill="currentColor" />
              </svg>
              <span>{content.hero.github}</span>
            </a>
          </div>
        </div>

        <div class="demo-frame" aria-label={content.hero.demoLabel}>
          <iframe
            src={demoSrc}
            title={content.hero.demoTitle}
            loading="eager"
            data-demo-frame
          ></iframe>
        </div>
      </section>

      <section class="showcase-section" id="showcase" aria-labelledby="showcase-title">
        <div class="section-heading">
          <h2 id="showcase-title">{content.showcase.title}</h2>
          <p>{content.showcase.body}</p>
        </div>

        <div class="showcase-grid">
          {
            content.showcase.cards.map((card) => (
              <article class:list={["feature-card", card.className]}>
                <span class="tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))
          }
        </div>

        <div class="note-showcase">
          <div class="note-outline" aria-label={content.showcase.noteOutlineLabel}>
            <p class="panel-label">{content.showcase.noteOutlinePanel}</p>
            <h3>{content.showcase.noteOutlineTitle}</h3>
            <ul>
              {
                content.showcase.noteOutlineItems.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="note-body-preview visual-evidence-panel">
            <p class="panel-label">{content.showcase.visualPanel}</p>
            <h3>{content.showcase.visualTitle}</h3>
            <p class="visual-evidence-copy">{content.showcase.visualBody}</p>
            <div class="visual-artifact" aria-label={content.showcase.visualArtifactLabel}>
              <div class="artifact-header">
                <span class="artifact-title">{content.showcase.artifactTitle}</span>
                <span class="artifact-chip">{content.showcase.artifactChip}</span>
              </div>
              <div class="figure-mini-map" aria-label={content.showcase.figureMapLabel}>
                <div class="model-stage input-stage">
                  <span class="stage-label">{content.showcase.stages.input}</span>
                  <span class="token-row" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                  </span>
                </div>
                <div class="model-stage compact-stage">
                  <span class="stage-label">{content.showcase.stages.embedding}</span>
                </div>
                <div class="attention-block">
                  <span class="stage-label">{content.showcase.stages.attention}</span>
                  <span class="attention-heads" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                  </span>
                  <span class="residual-label">{content.showcase.stages.residual}</span>
                </div>
                <div class="model-stage compact-stage">
                  <span class="stage-label">{content.showcase.stages.feedForward}</span>
                </div>
                <div class="model-stage output-stage">
                  <span class="stage-label">{content.showcase.stages.output}</span>
                  <span class="state-stack" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                  </span>
                </div>
              </div>
              <div class="formula-strip" aria-label={content.showcase.formulaLabel}>
                <span>Attention(Q, K, V)</span>
                <span>= softmax(QK<sup>T</sup> / &radic;d<sub>k</sub>)V</span>
              </div>
              <table class="evidence-table" aria-label={content.showcase.tableLabel}>
                <thead>
                  <tr>
                    {content.showcase.tableHeaders.map((header) => <th>{header}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {
                    content.showcase.tableRows.map((row) => (
                      <tr>
                        {row.map((cell) => <td>{cell}</td>)}
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <section class="pipeline-section" id="pipeline" aria-labelledby="pipeline-title">
        <div class="section-heading">
          <h2 id="pipeline-title">{content.pipeline.title}</h2>
          <p>{content.pipeline.body}</p>
        </div>
        <ol class="pipeline-steps">
          {
            content.pipeline.steps.map((step) => (
              <li>
                <strong>{step.title}</strong>
                <span>{step.body}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="install-section" id="install" aria-labelledby="install-title">
        <div>
          <h2 id="install-title">{content.install.title}</h2>
          <p>{content.install.body}</p>
        </div>
        <div class="terminal-card" aria-label={content.install.commandsLabel}>
          {content.install.commands.map((command) => <code>{command}</code>)}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span class="footer-credit">
        <span class="footer-product">DeepPaperNote</span>
        <span class="footer-muted">· {content.footer.by}</span>
        <a href="https://github.com/917Dhj">917Dhj</a>
      </span>
      <a class="github-link" href="https://github.com/917Dhj/DeepPaperNote">
        <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d={githubIconPath} fill="currentColor" />
        </svg>
        <span>{content.footer.github}</span>
      </a>
      <a href="https://github.com/917Dhj/DeepPaperNote/releases">{content.footer.releases}</a>
      <a href="https://github.com/917Dhj/DeepPaperNote/issues">{content.footer.issues}</a>
    </footer>
    <script>
      const starTarget = document.querySelector("[data-star-count]");

      if (starTarget) {
        const cacheKey = "deeppapernote:github-stars";
        const cacheTtl = 10 * 60 * 1000;
        const repoUrl = "https://api.github.com/repos/917Dhj/DeepPaperNote";
        const starPill = starTarget.closest("[data-star-pill]");
        const fallbackLabel = starTarget.getAttribute("data-star-fallback") || "Stars";
        const numberLocale = starTarget.getAttribute("data-star-locale") || "en";
        const ariaTemplate =
          starPill?.getAttribute("data-star-aria-template") || "{count} stars on GitHub";

        const formatStars = (count) => {
          if (!Number.isFinite(count)) {
            return fallbackLabel;
          }

          return new Intl.NumberFormat(numberLocale, {
            maximumFractionDigits: 1,
            notation: "compact",
          })
            .format(count)
            .toLowerCase();
        };

        const readCachedStars = () => {
          try {
            const cachedValue = localStorage.getItem(cacheKey);

            if (!cachedValue) {
              return null;
            }

            const parsedValue = JSON.parse(cachedValue);
            const count = Number(parsedValue.count);
            const timestamp = Number(parsedValue.timestamp);

            if (!Number.isFinite(count) || !Number.isFinite(timestamp)) {
              return null;
            }

            return { count, timestamp };
          } catch {
            return null;
          }
        };

        const writeCachedStars = (count) => {
          try {
            localStorage.setItem(
              cacheKey,
              JSON.stringify({
                count,
                timestamp: Date.now(),
              })
            );
          } catch {
            // Private browsing and strict storage settings can reject localStorage writes.
          }
        };

        const applyStars = (count) => {
          const label = formatStars(count);
          starTarget.textContent = label;
          starPill?.setAttribute("aria-label", ariaTemplate.replace("{count}", label));
        };

        const cachedStars = readCachedStars();

        if (cachedStars) {
          applyStars(cachedStars.count);
        }

        if (!cachedStars || Date.now() - cachedStars.timestamp >= cacheTtl) {
          fetch(repoUrl, {
            headers: {
              Accept: "application/vnd.github+json",
            },
          })
            .then((response) => {
              if (!response.ok) {
                throw new Error(`GitHub stars request failed: ${response.status}`);
              }

              return response.json();
            })
            .then((repo) => {
              const count = Number(repo.stargazers_count);

              if (!Number.isFinite(count)) {
                return;
              }

              applyStars(count);
              writeCachedStars(count);
            })
            .catch(() => {
              if (!cachedStars) {
                starTarget.textContent = fallbackLabel;
              }
            });
        }
      }
    </script>
  </body>
</html>
