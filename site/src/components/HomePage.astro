---
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";
import type { HomePageContent, Locale } from "../data/home";

interface Props {
  content: HomePageContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const githubIconPath =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z";
const themeIconPaths = {
  system: [
    "M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9",
    "M2 16h20",
    "M8 21h8",
    "M12 16v5",
  ],
  light: [
    "M12 3v1",
    "M12 20v1",
    "M3 12h1",
    "M20 12h1",
    "M18.364 5.636l-.707.707",
    "M6.343 17.657l-.707.707",
    "M5.636 5.636l.707.707",
    "M17.657 17.657l.707.707",
    "M8 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0",
  ],
  dark: [
    "M20.985 12.486A9 9 0 1 1 11.514 3.015 7 7 0 0 0 20.985 12.486",
  ],
};

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localePaths = {
  en: basePath,
  zh: `${basePath}zh/`,
};
const currentPath = localePaths[locale];
const faviconHref = `${basePath}favicon.svg`;
const demoLang = locale === "zh" ? "zh" : "en";
const paperDims: Record<string, [number, number]> = {
  "showcase/paper-figure-1.png": [924, 1412],
  "showcase/paper-table-2.png": [1616, 716],
  "showcase/paper-table-3.png": [1616, 1304],
};
const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// Excerpt markup: **bold**, ==highlight== (the first one anchors the connector), `code`, trailing [citation].
const richText = (text: string) =>
  escapeHtml(text)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/==(.+?)==/g, '<mark class="note-mark">$1</mark>')
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\s(\[[^\]]+\])$/, ' <span class="note-cite">$1</span>');
const demoSrc = `${basePath}demos/deeppapernote-note-demo/index.html?lang=${demoLang}`;
const releaseHref = "https://github.com/917Dhj/DeepPaperNote/releases/tag/v3.0.0";
const copyCommandLabel = locale === "zh" ? "复制命令" : "Copy command";
const copiedCommandLabel = locale === "zh" ? "已复制" : "Copied";
const copyFailedLabel = locale === "zh" ? "复制失败" : "Copy failed";
---

<html lang={content.lang} data-theme-preference="system" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={content.description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{content.title}</title>
    <script is:inline>
      (() => {
        const storageKey = "deeppapernote:theme";
        const allowedThemes = new Set(["system", "light", "dark"]);
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPreference = () => {
          try {
            const storedTheme = localStorage.getItem(storageKey);
            return allowedThemes.has(storedTheme) ? storedTheme : "system";
          } catch {
            return "system";
          }
        };

        const resolveTheme = (preference) =>
          preference === "system" ? (media.matches ? "dark" : "light") : preference;

        const syncButtons = (preference) => {
          document.querySelectorAll("[data-theme-choice]").forEach((button) => {
            const isActive = button.getAttribute("data-theme-choice") === preference;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));
          });
        };

        const applyTheme = (preference) => {
          const normalizedPreference = allowedThemes.has(preference) ? preference : "system";
          const theme = resolveTheme(normalizedPreference);
          document.documentElement.dataset.themePreference = normalizedPreference;
          document.documentElement.dataset.theme = theme;
          syncButtons(normalizedPreference);
        };

        const initialPreference = readPreference();
        document.documentElement.dataset.themePreference = initialPreference;
        document.documentElement.dataset.theme = resolveTheme(initialPreference);

        const bindControls = () => {
          applyTheme(readPreference());
          document.querySelectorAll("[data-theme-choice]").forEach((button) => {
            button.addEventListener("click", () => {
              const preference = button.getAttribute("data-theme-choice") || "system";

              try {
                localStorage.setItem(storageKey, preference);
              } catch {
                // Strict storage settings can reject localStorage writes.
              }

              applyTheme(preference);
            });
          });
        };

        const handleSystemChange = () => {
          if (readPreference() === "system") {
            applyTheme("system");
          }
        };

        if (media.addEventListener) {
          media.addEventListener("change", handleSystemChange);
        } else {
          media.addListener(handleSystemChange);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", bindControls, { once: true });
        } else {
          bindControls();
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header" aria-label={content.navLabel}>
      <a class="brand" href={currentPath} aria-label={content.brandHomeLabel}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" focusable="false">
            <path
              d="M19 14h13c12 0 20 7.5 20 18s-8 18-20 18H19V14Zm10 9v18h4c6.2 0 10-3.4 10-9s-3.8-9-10-9h-4Z"
              fill="#faf9f5"
            />
            <path d="M32 23h1c6.2 0 10 3.4 10 9s-3.8 9-10 9h-1V23Z" fill="#cc785c" />
          </svg>
        </span>
        <span>DeepPaperNote</span>
      </a>
      <nav class="nav-links" aria-label={content.navLabel}>
        <a href="#features">{content.nav.features}</a>
        <a href="#showcase">{content.nav.showcase}</a>
        <a href="#wiki">{content.nav.wiki}</a>
        <a href="#install">{content.nav.install}</a>
      </nav>
      <div class="header-actions" aria-label={content.headerActionsLabel}>
        <div class="locale-switch" aria-label={content.languageSwitchLabel}>
          <a
            class:list={["locale-link", { "is-active": locale === "en" }]}
            href={localePaths.en}
            aria-current={locale === "en" ? "page" : undefined}
            aria-label={content.languageNames.en}
          >
            EN
          </a>
          <a
            class:list={["locale-link", { "is-active": locale === "zh" }]}
            href={localePaths.zh}
            aria-current={locale === "zh" ? "page" : undefined}
            aria-label={content.languageNames.zh}
          >
            ZH
          </a>
        </div>
        <div class="theme-switch" aria-label={content.themeSwitchLabel}>
          <button
            class="theme-button"
            type="button"
            data-theme-choice="system"
            aria-label={content.theme.systemLabel}
            aria-pressed="true"
          >
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {themeIconPaths.system.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </button>
          <button
            class="theme-button"
            type="button"
            data-theme-choice="light"
            aria-label={content.theme.lightLabel}
            aria-pressed="false"
          >
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {themeIconPaths.light.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </button>
          <button
            class="theme-button"
            type="button"
            data-theme-choice="dark"
            aria-label={content.theme.darkLabel}
            aria-pressed="false"
          >
            <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {themeIconPaths.dark.map((path) => (
                <path d={path} />
              ))}
            </svg>
          </button>
        </div>
        <a
          class="star-pill"
          data-star-pill
          data-star-aria-template={content.starsAriaTemplate}
          href="https://github.com/917Dhj/DeepPaperNote"
          aria-label={content.githubStarsLabel}
        >
          <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d={githubIconPath} fill="currentColor" />
          </svg>
          <span class="github-label">GitHub</span>
          <span class="star-pill-divider" aria-hidden="true"></span>
          <span class="star-pill-icon" aria-hidden="true">★</span>
          <span
            class="star-pill-count"
            data-star-count
            data-star-fallback={content.starsFallback}
          >
            {content.starsFallback}
          </span>
        </a>
        <a class="button button-primary" href="#install">{content.installLabel}</a>
      </div>
    </header>

    <main>
      <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-content">
          <a class="hero-badge" href={releaseHref}>
            <span class="hero-badge-dot" aria-hidden="true"></span>{content.hero.badge}<span aria-hidden="true">→</span>
          </a>
          <h1 id="hero-title">{content.hero.title.split(/(?<=，)/).map((part) => <span class="title-seg">{part}</span>)}</h1>
          <p>{content.hero.body} <strong>{content.hero.bodyStrong}</strong></p>
          <div class="hero-actions" aria-label={content.hero.actionsLabel}>
            <a class="button button-primary" href="#install">{content.hero.install}</a>
            <a class="button button-on-dark github-link" href="https://github.com/917Dhj/DeepPaperNote">
              <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d={githubIconPath} fill="currentColor" />
              </svg>
              <span>{content.hero.github}</span>
            </a>
          </div>
        </div>

        <div class="demo-frame" aria-label={content.hero.demoLabel}>
          <iframe
            src={demoSrc}
            title={content.hero.demoTitle}
            loading="eager"
          ></iframe>
        </div>
      </section>

      <section class="showcase-section" id="features" aria-labelledby="features-title">
        <div class="section-heading">
          <h2 id="features-title">{content.features.title}</h2>
          <p>{content.features.body}</p>
        </div>

        <div class="showcase-grid features-grid">
          {
            content.features.cards.map((card) => (
              <article class:list={["feature-card", card.className]}>
                <span class="tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="showcase-section" id="showcase" aria-labelledby="showcase-title">
        <div class="section-heading">
          <h2 id="showcase-title">{content.showcase.title}</h2>
          <p>{content.showcase.body}</p>
        </div>

        <div class="pairs">
          {
            content.showcase.pairs.map((pair) => {
              const [x0, y0, x1, y1] = pair.paper.box;
              const dims = paperDims[pair.paper.src];
              return (
                <article class="pair">
                  <h3 class="pair-title">{pair.title}</h3>
                  <div class="pair-grid" data-pair>
                    <figure class="paper-card">
                      <div class="paper-sheet">
                        <div class="paper-frame">
                        <img
                          src={`${basePath}${pair.paper.src}`}
                          alt={pair.paper.alt}
                          width={dims?.[0]}
                          height={dims?.[1]}
                          loading="lazy"
                          decoding="async"
                        />
                        <span
                          class="paper-box"
                          data-pair-from
                          style={`left:${x0}%;top:${y0}%;width:${x1 - x0}%;height:${y1 - y0}%`}
                        ></span>
                        </div>
                      </div>
                      <figcaption>{pair.paper.caption}</figcaption>
                    </figure>
                    <div class="note-card">
                      <div class="note-card-bar">
                        <span class="note-card-label">{content.showcase.noteLabel}</span>
                        <span class="note-card-path">{pair.note.path}</span>
                      </div>
                      <div class="note-card-body">
                        {
                          pair.note.blocks.map((block) =>
                            block.kind === "table" ? (
                              <table class="note-table">
                                <thead>
                                  <tr>
                                    {block.headers.map((header, col) => (
                                      <th class:list={{ num: block.numeric.includes(col) }}>{header}</th>
                                    ))}
                                  </tr>
                                </thead>
                                <tbody>
                                  {block.rows.map((row, rowIndex) => (
                                    <tr class:list={{ "is-hl": rowIndex === block.highlight }}>
                                      {row.map((cell, col) => (
                                        <td class:list={{ num: block.numeric.includes(col) }} set:html={richText(cell)} />
                                      ))}
                                    </tr>
                                  ))}
                                </tbody>
                              </table>
                            ) : (
                              <p class:list={["note-text", { "note-caption": block.kind === "caption" }]} set:html={richText(block.text)} />
                            ),
                          )
                        }
                      </div>
                    </div>
                    <svg class="pair-link" aria-hidden="true" focusable="false">
                      <path pathLength="1" />
                      <circle r="4" />
                    </svg>
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section class="showcase-section wiki-section" id="wiki" aria-labelledby="wiki-title">
        <div class="section-heading">
          <h2 id="wiki-title">{content.wiki.title}</h2>
          <p>{content.wiki.body}</p>
        </div>

        <div class="wiki-grid">
          {
            content.wiki.skills.map((skill, index) => (
              <article class:list={["skill-card", { "skill-core": index === 0 }]}>
                <h3 class="skill-name">
                  <code>{skill.name}</code>
                  {index === 0 && <span class="skill-core-label">{content.wiki.coreLabel}</span>}
                </h3>
                <p class="skill-body">{skill.body}</p>
                {index === 0 && <pre class="skill-tree"><code>{content.wiki.coreTree}</code></pre>}
                <p class="skill-call">
                  <code class="skill-command">/{skill.name}</code>
                  <span class="skill-phrase">“{skill.phrase}”</span>
                </p>
              </article>
            ))
          }
        </div>

        <div class="rhythm" aria-label={content.wiki.rhythmLabel}>
          <span class="rhythm-line" aria-hidden="true"></span>
          <ol>
            {content.wiki.rhythm.map((step) => <li>{step}</li>)}
          </ol>
        </div>
      </section>

      <!-- The anchor sits on a still wrapper: the section's scroll-driven transform would skew the scroll target. -->
      <div id="install">
      <section class="install-section" aria-labelledby="install-title">
        <div class="install-copy">
          <h2 id="install-title">{content.install.title}</h2>
          <p>{content.install.body}</p>
          <a class="install-update" href={content.install.updateHref}>{content.install.updateLabel}</a>
        </div>
        <div class="terminal-card" aria-label={content.install.commandsLabel}>
          <div class="terminal-tabs" role="tablist" aria-label={content.install.commandsLabel}>
            {
              content.install.tabs.map((tab, index) => (
                <button
                  class="terminal-tab"
                  type="button"
                  role="tab"
                  id={`install-tab-${tab.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls={`install-panel-${tab.id}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-install-tab={tab.id}
                >
                  {tab.label}
                </button>
              ))
            }
          </div>
          {
            content.install.tabs.map((tab, index) => (
              <div
                class="terminal-step"
                role="tabpanel"
                id={`install-panel-${tab.id}`}
                aria-labelledby={`install-tab-${tab.id}`}
                data-install-panel={tab.id}
                hidden={index !== 0}
              >
                <p class="terminal-comment">{tab.comment}</p>
                <div class="terminal-command">
                <code>{tab.command}</code>
                <button
                  class="copy-command-button"
                  type="button"
                  aria-label={copyCommandLabel}
                  title={copyCommandLabel}
                  data-copy-command={tab.command}
                  data-copy-label={copyCommandLabel}
                  data-copied-label={copiedCommandLabel}
                  data-failed-label={copyFailedLabel}
                >
                  <svg
                    class="copy-command-icon copy-command-icon-copy"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <svg
                    class="copy-command-icon copy-command-icon-check"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                </button>
                <span class="copy-status" role="status"></span>
              </div>
              </div>
            ))
          }
          {
            content.install.steps.map((step) => (
              <div class="terminal-step">
                <p class="terminal-comment">{step.comment}</p>
              <div class="terminal-command">
                <code>{step.command}</code>
                <button
                  class="copy-command-button"
                  type="button"
                  aria-label={copyCommandLabel}
                  title={copyCommandLabel}
                  data-copy-command={step.command}
                  data-copy-label={copyCommandLabel}
                  data-copied-label={copiedCommandLabel}
                  data-failed-label={copyFailedLabel}
                >
                  <svg
                    class="copy-command-icon copy-command-icon-copy"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <svg
                    class="copy-command-icon copy-command-icon-check"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                </button>
                <span class="copy-status" role="status"></span>
              </div>
              </div>
            ))
          }
        </div>
      </section>
      </div>
    </main>

    <section class="closing-note">
      <p>
        <em>{content.closingNote}</em>
      </p>
    </section>

    <footer class="site-footer">
      <div class="footer-links">
        <span class="footer-credit">
          <span class="footer-product">DeepPaperNote</span>
          <span class="footer-muted">· {content.footer.by}</span>
          <a href="https://github.com/917Dhj">917Dhj</a>
        </span>
        <a class="github-link" href="https://github.com/917Dhj/DeepPaperNote">
          <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d={githubIconPath} fill="currentColor" />
          </svg>
          <span>{content.footer.github}</span>
        </a>
        <a href="https://github.com/917Dhj/DeepPaperNote/releases">{content.footer.releases}</a>
        <a href="https://github.com/917Dhj/DeepPaperNote/issues">{content.footer.issues}</a>
      </div>
    </footer>
    <script>
      const drawPairLinks = () => {
        const wide = window.matchMedia("(min-width: 1024px)").matches;
        document.querySelectorAll("[data-pair]").forEach((grid) => {
          const svg = grid.querySelector(".pair-link");
          const path = svg?.querySelector("path");
          const dot = svg?.querySelector("circle");
          const from = grid.querySelector("[data-pair-from]");
          const mark = grid.querySelector(".note-mark");
          const card = grid.querySelector(".note-card");
          if (!svg || !path || !dot || !from || !mark || !card) return;
          svg.toggleAttribute("hidden", !wide);
          if (!wide) return;
          // Layout offsets, not client rects, so scroll-linked transforms never skew the endpoints.
          const offset = (element) => {
            let x = 0;
            let y = 0;
            for (let node = element; node && node !== grid; node = node.offsetParent) {
              x += node.offsetLeft;
              y += node.offsetTop;
            }
            return { x, y };
          };
          const box = offset(from);
          const markAt = offset(mark);
          const fx = box.x + from.offsetWidth;
          const fy = box.y + from.offsetHeight / 2;
          const tx = offset(card).x - 8;
          // Aim at the first line of the highlight, even when it wraps.
          const lineHeight = parseFloat(getComputedStyle(mark).lineHeight) || mark.offsetHeight;
          const ty = markAt.y + Math.min(mark.offsetHeight, lineHeight) / 2;
          const bend = Math.max(48, (tx - fx) * 0.5);
          svg.setAttribute("viewBox", `0 0 ${grid.offsetWidth} ${grid.offsetHeight}`);
          path.setAttribute("d", `M ${fx} ${fy} C ${fx + bend} ${fy}, ${tx - bend} ${ty}, ${tx} ${ty}`);
          dot.setAttribute("cx", String(tx));
          dot.setAttribute("cy", String(ty));
        });
      };

      drawPairLinks();
      window.addEventListener("resize", drawPairLinks);
      const pairObserver = new ResizeObserver(() => drawPairLinks());
      document.querySelectorAll("[data-pair]").forEach((grid) => pairObserver.observe(grid));
      window.addEventListener("load", drawPairLinks);
      document.fonts.ready.then(drawPairLinks);

      const installTabs = [...document.querySelectorAll("[data-install-tab]")];
      const selectInstallTab = (tab, focus = false) => {
        installTabs.forEach((other) => {
          const active = other === tab;
          other.setAttribute("aria-selected", String(active));
          other.tabIndex = active ? 0 : -1;
          const panel = document.querySelector(`[data-install-panel="${other.dataset.installTab}"]`);
          if (panel) panel.hidden = !active;
        });
        if (focus) tab.focus();
      };
      installTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectInstallTab(tab));
        tab.addEventListener("keydown", (event) => {
          const last = installTabs.length - 1;
          const target = {
            ArrowRight: index === last ? 0 : index + 1,
            ArrowLeft: index === 0 ? last : index - 1,
            Home: 0,
            End: last,
          }[event.key];
          if (target === undefined) return;
          event.preventDefault();
          selectInstallTab(installTabs[target], true);
        });
      });

      const starTarget = document.querySelector("[data-star-count]");

      if (starTarget) {
        const cacheKey = "deeppapernote:github-stars";
        const cacheTtl = 10 * 60 * 1000;
        const repoUrl = "https://api.github.com/repos/917Dhj/DeepPaperNote";
        const starPill = starTarget.closest("[data-star-pill]");
        const fallbackLabel = starTarget.getAttribute("data-star-fallback") || "Stars";
        const ariaTemplate =
          starPill?.getAttribute("data-star-aria-template") || "{count} stars on GitHub";

        const formatStars = (count) => {
          if (!Number.isFinite(count)) {
            return fallbackLabel;
          }

          return new Intl.NumberFormat("en", {
            maximumFractionDigits: 1,
            notation: "compact",
          })
            .format(count)
            .toLowerCase();
        };

        const readCachedStars = () => {
          try {
            const cachedValue = localStorage.getItem(cacheKey);

            if (!cachedValue) {
              return null;
            }

            const parsedValue = JSON.parse(cachedValue);
            const count = Number(parsedValue.count);
            const timestamp = Number(parsedValue.timestamp);

            if (!Number.isFinite(count) || !Number.isFinite(timestamp)) {
              return null;
            }

            return { count, timestamp };
          } catch {
            return null;
          }
        };

        const writeCachedStars = (count) => {
          try {
            localStorage.setItem(
              cacheKey,
              JSON.stringify({
                count,
                timestamp: Date.now(),
              })
            );
          } catch {
            // Private browsing and strict storage settings can reject localStorage writes.
          }
        };

        const applyStars = (count) => {
          const label = formatStars(count);
          starTarget.textContent = label;
          starPill?.setAttribute("aria-label", ariaTemplate.replace("{count}", label));
        };

        const cachedStars = readCachedStars();

        if (cachedStars) {
          applyStars(cachedStars.count);
        }

        if (!cachedStars || Date.now() - cachedStars.timestamp >= cacheTtl) {
          fetch(repoUrl, {
            headers: {
              Accept: "application/vnd.github+json",
            },
          })
            .then((response) => {
              if (!response.ok) {
                throw new Error(`GitHub stars request failed: ${response.status}`);
              }

              return response.json();
            })
            .then((repo) => {
              const count = Number(repo.stargazers_count);

              if (!Number.isFinite(count)) {
                return;
              }

              applyStars(count);
              writeCachedStars(count);
            })
            .catch(() => {
              if (!cachedStars) {
                starTarget.textContent = fallbackLabel;
              }
            });
        }
      }

      // VoiceOver skips a repeat of the previous message, so a repeat gets an invisible no-break space.
      let lastCopyMessage = "";

      document.querySelectorAll("[data-copy-command]").forEach((button) => {
        let resetTimer;
        const status = button.nextElementSibling;

        button.addEventListener("click", async () => {
          const command = button.getAttribute("data-copy-command");

          if (!command) {
            return;
          }

          const copyLabel = button.getAttribute("data-copy-label") || "Copy command";
          let copied = true;

          try {
            await navigator.clipboard.writeText(command);
          } catch {
            copied = false;
          }

          const label = copied
            ? button.getAttribute("data-copied-label") || "Copied"
            : button.getAttribute("data-failed-label") || "Copy failed";
          const message = label === lastCopyMessage ? `${label} ` : label;
          lastCopyMessage = message;

          window.clearTimeout(resetTimer);
          button.classList.toggle("is-copied", copied);
          button.setAttribute("title", label);
          status.textContent = message;
          resetTimer = window.setTimeout(() => {
            button.classList.remove("is-copied");
            button.setAttribute("title", copyLabel);
            status.textContent = "";
          }, 1600);
        });
      });
    </script>
  </body>
</html>
